@startuml seq_login
' Render to ../images/seq_login.pdf
actor User
participant "Angular SPA" as FE
participant "FastAPI Backend" as BE
database "PostgreSQL" as DB

User -> FE : enter email + password
FE -> BE : POST /api/v1/auth/login
BE -> DB : fetch user by email
DB --> BE : user (hashed password)
BE -> BE : verify password hash
alt valid credentials
  BE -> BE : issue access + refresh JWT
  BE --> FE : 200 {access, refresh}
  FE -> FE : store tokens
  FE --> User : redirect to dashboard
else invalid
  BE --> FE : 401 Unauthorized
  FE --> User : show error
end
@enduml
