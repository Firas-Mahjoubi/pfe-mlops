@startuml usecase_global
' Render:  plantuml -tpdf usecase_global.puml   (or paste into plantuml.com)
' Then move usecase_global.pdf into ../images/
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Platform User\n(Data Scientist)" as User
actor "External API Client" as Client
actor "Administrator" as Admin

rectangle "MLOps Platform" {
  usecase "Sign up / Sign in"        as UC1
  usecase "Manage projects"          as UC2
  usecase "Upload code & dataset"    as UC3
  usecase "Trigger training run"     as UC4
  usecase "Browse experiments"       as UC5
  usecase "Register / promote model" as UC6
  usecase "Deploy model"             as UC7
  usecase "Test prediction"          as UC8
  usecase "View metrics dashboard"   as UC9
  usecase "Manage API keys"          as UC10
  usecase "Call public prediction"   as UC11
  usecase "Manage users & roles"     as UC12
  usecase "View platform overview"   as UC13
  usecase "Oversee all resources"    as UC14
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10
Client --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14

' Actor generalization: the Administrator inherits every capability of the
' Platform User (has all user use cases) in addition to the admin-only ones.
Admin --|> User

UC2 ..> UC1 : <<include>>
UC4 ..> UC3 : <<include>>
UC7 ..> UC6 : <<include>>
@enduml


